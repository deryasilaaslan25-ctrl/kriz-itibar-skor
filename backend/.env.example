# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin.
# Doldurulmayan API anahtarları ilgili veri kaynağını "devre dışı" bırakır,
# sistem geri kalanıyla (mock veri + demo modu) çalışmaya devam eder.

ENV=development

# Bellek kısıtlı ortamlarda (ör. Render/Railway ücretsiz katman, ~512MB RAM) true
# yapın: transformer tabanlı ağır modeller (BERTurk/XLM-R/mDeBERTa, ~1-2GB RAM)
# hiç yüklenmeye çalışılmaz, sistem sözlük/anahtar-kelime tabanlı motorlarla
# çalışır (bkz. app/config.py LITE_MODE açıklaması).
LITE_MODE=false

# --- Veritabanı ---
DATABASE_URL=postgresql+psycopg2://itibar_user:itibar_pass@localhost:5432/itibar_db
REDIS_URL=redis://localhost:6379/0

# --- Güvenlik ---
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
# Üretimde "*" yerine gerçek frontend domain'i girin (virgülle ayrılmış liste değil,
# pydantic-settings JSON listesi bekler, örn. ["https://itibar.kurumadi.com"])
CORS_ALLOWED_ORIGINS=["*"]

# --- LLM Entegrasyonu (Bölüm 8-9, opsiyonel) ---
# Tanımlanmazsa sistem yalnızca kural-tabanlı SCCT önerisiyle çalışmaya devam eder
# (bkz. app/services/llm_advisor.py — graceful degradation).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Dış Veri Kaynakları (Bölüm 4) ---
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWSAPI_KEY=
GOOGLE_TRENDS_ENABLED=false
# YouTube: BOŞ BIRAKILABİLİR. YouTubeCollector anahtarsız da (yt-dlp ile arama
# ve yorum toplama) tam işlevsel çalışır. Buraya sadece, ileride Google Cloud
# Console'dan ÜCRETSİZ bir "YouTube Data API v3" anahtarı edinirseniz (kota
# ve güvenilirlik avantajı için) o anahtarı girin — .env dışında HİÇBİR kod
# değişikliği gerekmez.
YOUTUBE_API_KEY=

# --- Bildirim Kanalları (Bölüm 18) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TEAMS_WEBHOOK_URL=
